{
  "expo": {
    "name": "App_code",
    "slug": "App_code",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.gracyterezevazola.App_code"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["react-native-ble-plx", { "isBackgroundEnabled": false, "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to your watch" }],
      "./plugins/withNotificationListener"
    ],
    "extra": {
      "eas": {
        "projectId": "55021f4b-3799-47dc-baf9-8885bd237bad"
      }
    }
  }
}
